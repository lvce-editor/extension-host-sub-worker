{
  "name": "@lvce-editor/extension-host-sub-worker-monorepo",
  "version": "0.0.0-dev",
  "description": "",
  "main": "",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b",
    "build:watch": "./node_modules/.bin/esbuild --external:node:buffer --external:electron --external:ws --external:node:worker_threads --format=esm --bundle --watch packages/extension-host-sub-worker/src/extensionHostSubWorkerMain.js --outfile=.tmp/dist/dist/extensionHostSubWorkerMain.js",
    "build": "node packages/build/src/build.js",
    "build:static": "node packages/build/src/build-static.js",
    "dev": "node packages/build/src/dev.js",
    "format": "prettier --write .",
    "measure": "npm run measure --workspace=@lvce-editor/about-view-worker-memory"
  },
  "author": "Lvce Editor",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@lvce-editor/eslint-config": "^17.5.0",
    "@types/eslint__js": "^9.14.0",
    "eslint": "^10.8.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "prettier": "^3.6.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.47.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 150
  }
}
